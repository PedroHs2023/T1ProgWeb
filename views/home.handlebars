<section class="home">
    <h2>Agendamento de banho e tosa</h2>

    <form id="formAgendamento">
        <label for="data">Data do atendimento</label>
        <input type="date" id="data" name="data" required>

        <button type="button" id="consultarHorarios">
            Consultar horários da semana
        </button>

        <fieldset>
            <legend>Disponibilidade semanal</legend>
            <div id="calendarioSemanal" aria-live="polite">
                Selecione uma data e consulte a semana.
            </div>
        </fieldset>

        <label for="nome">Nome</label>
        <input type="text" id="nome" name="nome" required>

        <label for="cpf">CPF</label>
        <input type="text" id="cpf" name="cpf" required>

        <button type="submit" id="confirmarAgendamento">
            Confirmar agendamento
        </button>

        <p id="mensagem" role="status"></p>
    </form>
</section>

<script src="/js/cliente.js" defer></script>